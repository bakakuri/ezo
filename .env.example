# Supabase → Project Settings → API Keys (publishable; ძველი anon „eyJ…“ გასაღებიც მუშაობს 2026-ის ბოლომდე)
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...
# 1 = დემო რეჟიმი (მონაცემები მეხსიერებაში, Supabase არ სჭირდება)
VITE_DEMO=0
# Push შეტყობინებები: VAPID საჯარო გასაღები (საიდუმლოს — Supabase Edge Function Secrets-ში)
VITE_VAPID_PUBLIC_KEY=
# ზარები: TURN სერვერი მობილური ინტერნეტისთვის (არასავალდებულო, მაგრამ 4G/5G-ზე ზარების ნაწილი მის გარეშე ვერ დაუკავშირდება)
# რამდენიმე მისამართი მძიმით: turn:host:3478,turns:host:443?transport=tcp
VITE_TURN_URLS=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
# ბოტებისგან დაცვა: Cloudflare Turnstile-ის Site Key (Secret Key — მხოლოდ Supabase-ში, CAPTCHA-ს პარამეტრებში)
VITE_TURNSTILE_SITE_KEY=
# მხოლოდ Vercel-ის სერვერისთვის (api/daily.js — წაშლილი ფოტოების დასუფთავება). საიდუმლოა: არასდროს VITE_-ით!
# SUPABASE_SERVICE_ROLE_KEY=
# CRON_SECRET=
